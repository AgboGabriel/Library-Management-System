    public static void Controller(int choice){
         try {
           
            switch(choice){
                case 1: 
                    System.out.println("Adding Item ....");
                    addItemToLibrary();
                    System.out.println("Item Added");
                  
                    break;
                case 2:

                    System.out.println("Remove Items");
                    break;
                case 3:
                    System.out.println("Search items");
                    break;
                case 4:
                    System.out.println("Registering members: ");
                    registeringMembers(member1);
