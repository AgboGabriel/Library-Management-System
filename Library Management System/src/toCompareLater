    }
    public static void addItemToLibrary() throws DuplicateMemberException{
     
        
          try {
            library.addItem(book1);
        } catch (ItemNotAvailable e) {
            System.out.println(e);
        }
    }


    public static void registeringMembers(Member m) throws DuplicateMemberException{
     
        try {
               library.registerMember(m);
        } catch (DuplicateMemberException e) {
            // TODO: handle exception
            System.out.println(e);
        }
    }
    
   

   
