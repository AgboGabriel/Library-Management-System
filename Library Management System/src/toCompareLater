       ArrayList<LibraryItem> list =new ArrayList<>();
       list.add(book1);
       Member member1=new Member("1", "Gabriel Agbo", list, 0.0);

        
        displayMenu();
        int choice=scanner.nextInt();
        Controller(choice);
       System.out.println("\nEnter Y to Continue or N to stop\n");
       char Option=scanner.next().toLowerCase().charAt(0);
       
        while( toContinue(Option)){
              displayMenu();
              choice=scanner.nextInt();
              Controller(choice);
              System.out.println("\nEnter Y to Continue or N to stop\n");
             Option=scanner.next().toLowerCase().charAt(0);

        }
    }
       
        
   
 //Helper method for taking integer input from the user
   
    
   static  boolean toContinue(char Option){
         if(Option=='y'){
            myOption=true;
            
        }
        else if(Option=='n'){
            myOption=false;
        }
        else{
            System.out.println("\nPlease enter a valid option !!!!!!\n");
            
        }
        return myOption;
    }
